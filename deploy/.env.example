# Production template; replace all example values. Do not commit real secrets.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18081
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/personal_website
DATABASE_USERNAME=website
DATABASE_PASSWORD=replace-with-database-password
SITE_ADMIN_EMAIL=replace-with-admin-email
# Only required when creating the first administrator. Remove after initialization.
SITE_ADMIN_PASSWORD=replace-with-initial-admin-password
SESSION_COOKIE_SECURE=true
SITE_CORS_ALLOWED_ORIGINS=https://example.com
SITE_UPLOADS_DIRECTORY=/var/lib/goodfly777/uploads
SITE_GALLERY_SEED_ENABLED=false
